<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="top.jspf" %>
<h1>Digital licences</h1><div class="card"><h2>Add licence</h2><form method="post" class="form-grid"><input type="hidden" name="action" value="add"><label>Book<select name="book_id" required><option value="">Choose book</option><c:forEach items="${books}" var="b"><option value="${b.id}">${b.title}</option></c:forEach></select></label><label>Format<input name="format" placeholder="PDF / EPUB" required></label><label>Digital URL<input type="url" name="digital_url" required></label><label>Concurrent limit<input type="number" name="concurrent_limit" min="1" value="1" required></label><button>Add licence</button></form></div>
<div class="card"><h2>Licence register</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Book ID</th><th>Format</th><th>URL</th><th>Concurrent limit</th><th>Active count</th><th>Action</th></tr></thead><tbody><c:forEach items="${items}" var="d"><tr><td>${d.id}</td><td>${d.book_id}</td><td>${d.format}</td><td><a href="${d.digital_url}" target="_blank" rel="noopener">Open</a></td><td>${d.concurrent_limit}</td><td>${d.active_count}</td><td><form method="post" class="inline"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${d.id}"><button class="danger">Delete</button></form></td></tr></c:forEach></tbody></table></div></div>
<%@ include file="bottom.jspf" %>

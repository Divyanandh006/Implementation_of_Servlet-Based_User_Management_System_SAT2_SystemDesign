<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="top.jspf" %>
<h1>Book catalogue</h1>
<div class="card"><h2>Add book</h2><form method="post" class="form-grid"><input type="hidden" name="action" value="add"><label>Title<input name="title" required></label><label>Author<input name="author" required></label><label>ISBN<input name="isbn"></label><label>Total copies<input type="number" name="total_copies" min="1" value="1" required></label><label>Available copies<input type="number" name="available_copies" min="0" value="1" required></label><label>Digital URL (optional)<input type="url" name="digital_url"></label><button>Add book</button></form></div>
<div class="card"><h2>Books</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Title</th><th>Author</th><th>ISBN</th><th>Copies</th><th>Available</th><th>Digital URL</th><th>Action</th></tr></thead><tbody><c:forEach items="${items}" var="b"><tr><td>${b.id}</td><td>${b.title}</td><td>${b.author}</td><td>${b.isbn}</td><td>${b.total_copies}</td><td>${b.available_copies}</td><td><c:if test="${not empty b.digital_url}"><a href="${b.digital_url}" target="_blank" rel="noopener">Open</a></c:if></td><td><form method="post" class="inline"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${b.id}"><button class="danger" onclick="return confirm('Delete this book?')">Delete</button></form></td></tr></c:forEach></tbody></table></div></div>
<%@ include file="bottom.jspf" %>

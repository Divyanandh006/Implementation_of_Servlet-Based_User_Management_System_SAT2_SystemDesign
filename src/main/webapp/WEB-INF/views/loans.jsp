<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="top.jspf" %>
<h1>Loans & circulation</h1>
<div class="card"><h2>Check out a book</h2><form method="post" class="form-grid"><input type="hidden" name="action" value="checkout"><label>Member<select name="member_id" required><option value="">Choose member</option><c:forEach items="${members}" var="m"><option value="${m.id}">${m.full_name} (#${m.id})</option></c:forEach></select></label><label>Available book<select name="book_id" required><option value="">Choose book</option><c:forEach items="${books}" var="b"><option value="${b.id}">${b.title} (${b.available_copies} available)</option></c:forEach></select></label><button>Check out (14 days)</button></form></div>
<div class="card"><h2>Loan register</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Member</th><th>Book</th><th>Checkout</th><th>Due</th><th>Return</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach items="${items}" var="l"><tr><td>${l.id}</td><td>${l.full_name}</td><td>${l.title}</td><td>${l.checkout_date}</td><td>${l.due_date}</td><td>${l.return_date}</td><td>${l.status}</td><td><c:if test="${l.status eq 'BORROWED'}"><form method="post" class="inline"><input type="hidden" name="id" value="${l.id}"><button name="action" value="return">Return</button></form><form method="post" class="inline"><input type="hidden" name="id" value="${l.id}"><button name="action" value="renew" class="secondary">Renew</button></form></c:if></td></tr></c:forEach></tbody></table></div></div>
<%@ include file="bottom.jspf" %>

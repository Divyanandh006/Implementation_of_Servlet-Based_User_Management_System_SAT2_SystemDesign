<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="top.jspf" %>
<h1>Fines</h1><div class="card"><p>Late-return fine rule: ₹5 per overdue day. This is a demo ledger; marking paid records payment status only and does not process real money.</p><div class="table-wrap"><table><thead><tr><th>ID</th><th>Member</th><th>Book</th><th>Loan ID</th><th>Amount (₹)</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${items}" var="f"><tr><td>${f.id}</td><td>${f.full_name}</td><td>${f.title}</td><td>${f.loan_id}</td><td>${f.amount}</td><td><c:choose><c:when test="${f.paid}">PAID</c:when><c:otherwise>UNPAID</c:otherwise></c:choose></td><td><c:if test="${not f.paid}"><form method="post" class="inline"><input type="hidden" name="id" value="${f.id}"><button>Mark paid</button></form></c:if></td></tr></c:forEach></tbody></table></div></div>
<%@ include file="bottom.jspf" %>

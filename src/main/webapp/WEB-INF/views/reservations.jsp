<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="top.jspf" %>
<h1>Reservations</h1><div class="card"><h2>Place reservation</h2><form method="post" class="form-grid"><label>Member<select name="member_id" required><option value="">Choose member</option><c:forEach items="${members}" var="m"><option value="${m.id}">${m.full_name}</option></c:forEach></select></label><label>Book<select name="book_id" required><option value="">Choose book</option><c:forEach items="${books}" var="b"><option value="${b.id}">${b.title}</option></c:forEach></select></label><button>Reserve</button></form></div>
<div class="card"><h2>Reservation queue (oldest first)</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Member</th><th>Book</th><th>Created</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${items}" var="r"><tr><td>${r.id}</td><td>${r.full_name}</td><td>${r.title}</td><td>${r.created_at}</td><td>${r.status}</td><td><c:if test="${r.status eq 'WAITING'}"><form method="post" class="inline"><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value="${r.id}"><button class="danger">Cancel</button></form></c:if></td></tr></c:forEach></tbody></table></div></div>
<%@ include file="bottom.jspf" %>
